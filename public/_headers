/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; img-src 'self' landscapes-images.pages.dev res.cloudinary.com images.unsplash.com www.google-analytics.com www.googletagmanager.com c.clarity.ms c.bing.com data:; script-src 'self' 'unsafe-inline' 'unsafe-eval' www.clarity.ms scripts.clarity.ms www.googletagmanager.com static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' fonts.googleapis.com; font-src 'self' fonts.gstatic.com; connect-src 'self' formspree.io raw.githubusercontent.com api.open-meteo.com *.clarity.ms c.bing.com cloudflareinsights.com www.googletagmanager.com www.google-analytics.com *.google-analytics.com *.analytics.google.com; frame-ancestors 'none'

# 静的アセット (Next.js _next/) は長期キャッシュ
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# HTML はやや短め (rebuild 時に新版を素早く配信)
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# ⑦ 自由文検索のモデル。分割片は内容が変わらないので長めに持たせる。
# 閲覧側は取れた分を Cache Storage にも置くので、通常はここまで来ない
# (Cache Storage が使えない環境での取り直しを減らすための保険)。
/models/*
  Cache-Control: public, max-age=2592000

# onnxruntime-web の実行部。onnxruntime-web のバージョンを上げない限り変わらない。
# これは ORT 自身が読むので Cache Storage に入れられない。ここで持たせないと
# 再読み込みのたびに 9.6MB を取り直す (実測で確認)。
# ワイルドカードに頼らず実ファイル名で指定する。
/ort/ort-wasm-simd.wasm
  Cache-Control: public, max-age=2592000
/ort/ort-wasm.wasm
  Cache-Control: public, max-age=2592000

# Sitemap/Feed は中程度キャッシュ
/sitemap*.xml
  Cache-Control: public, max-age=3600
/feed.xml
  Cache-Control: public, max-age=3600
